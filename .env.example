LOCAL_USERNAME = maker
LOCAL_PASSWORD = secret
# Core One mode: fetch snapshots from a plain HTTP endpoint instead of PrusaLink cameras
SET_CORE_ONE = False
CORE_ONE_IMG = 192.168.1.50
POLL_CYCLE_SECONDS = 15
MAIN_LOOP_SLEEP_SECONDS = 5
CONFIDENCE_THRESHOLD = 0.3
CONSECUTIVE_FAILURE_LIMIT = 3
ML_API_TIMEOUT = 30
# Printer manager API webhook: receives a multipart POST (printer_name, ip,
# cancelled_at, progress, latest image) with an X-Api-Key header when the AI
# stops a print. Leave unset/empty to disable; never used in Core One mode.
# MANAGER_API_URL = http://printer-manager.local/webhook/spaghetti-detected
# MANAGER_API_KEY = shared-secret
MANAGER_API_TIMEOUT = 30
LOG_LEVEL = INFO
